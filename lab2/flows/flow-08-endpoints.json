    {
        "id": "5319cfb04c24a251",
        "type": "function",
        "z": "5d0e21dd11c1e3b5",
        "name": "Items валидация",
        "func": "const q = msg.req.query;\n\nif (!q.count) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"count is required\" };\n    msg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\n    return msg;\n}\n\nconst count = parseInt(q.count, 10);\n\nif (isNaN(count) || count < 1 || count > 10) {\n    msg.statusCode = 400;\n    msg.payload = { error: \"count must be 1..10\" };\n    msg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\n    return msg;\n}\n\nmsg.statusCode = 200;\nmsg.payload = {\n    count: count,\n    items: Array.from({ length: count }, (_, i) => `item-${i + 1}`)\n};\nmsg.headers = { \"Content-Type\": \"application/json; charset=utf-8\" };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
